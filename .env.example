# Aurora Agent AI — Environment Configuration

# ============================================================================
# 1. MISTRAL AI (RECOMMENDED — FREE TIER)
# Get a free API key at: https://console.mistral.ai/api-keys/
# Choose the free "Experiment" plan (no credit card required).
# ============================================================================
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral-small-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed

# ============================================================================
# 2. OPTIONAL ALTERNATIVE LLMs (Groq Free Tier or OpenAI Paid Tier)
# If MISTRAL_API_KEY is set, Aurora uses Mistral first.
# ============================================================================
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ============================================================================
# 3. SUPABASE CONFIGURATION (Optional for local demo; required for cloud RAG)
# ============================================================================
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=knowledge-files

# ============================================================================
# 4. VAPI VOICE CONFIGURATION (Optional — enables real-time voice widget)
# ============================================================================
VAPI_PUBLIC_KEY=your_vapi_public_key
VAPI_ASSISTANT_ID=your_vapi_assistant_id
VAPI_API_KEY=your_vapi_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
